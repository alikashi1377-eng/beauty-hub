# NODE_ENV: Runtime environment ('development' | 'production' | 'test').
NODE_ENV="production"

# PORT: Server listening port (defaults to 3000 on Liara Node.js platform).
PORT="3000"

# DATA_MODE: Controls backend data mode ('mock' | 'real').
# Defaults to 'mock' when DATABASE_URL is empty, or 'real' when DATABASE_URL is provided.
DATA_MODE="mock"

# DATABASE_URL: Server-side PostgreSQL 17 connection string (e.g., Liara managed PostgreSQL).
# Example format (DO NOT commit real credentials):
# postgresql://postgres:YOUR_PASSWORD@YOUR_LIARA_DB_HOST:5432/postgres
DATABASE_URL=""

# DATABASE_SSL: PostgreSQL SSL mode ('disable' | 'no-verify' | 'require').
# For Liara internal network use 'disable'; for Liara external/managed TLS use 'no-verify' or 'require'.
DATABASE_SSL="disable"

# DB_POOL_MAX: Maximum number of connections in the PostgreSQL pool (default: 10, max: 50).
DB_POOL_MAX="10"

# DB_CONNECT_TIMEOUT_MS: PostgreSQL connection timeout in milliseconds (default: 4000).
DB_CONNECT_TIMEOUT_MS="4000"

# OTP_HMAC_SECRET: Secret key used to HMAC-SHA256 one-time passwords (REQUIRED in production, min 32 chars).
# Generate a strong secret locally via: openssl rand -hex 32
OTP_HMAC_SECRET=""

# SESSION_SECRET: Secret key used to sign/verify user session tokens (REQUIRED in production, min 32 chars).
# Generate a strong secret locally via: openssl rand -hex 32
SESSION_SECRET=""

# ==============================================================================
# SMS GATEWAY (OTP Delivery)
# ==============================================================================
# SMS_PROVIDER: 'disabled' | 'console' (dev/test only) | 'kavenegar' | 'smsir' | 'melipayamak' | 'webhook'
# In NODE_ENV=production, OTP will NOT be reported as sent unless a real provider confirms delivery.
SMS_PROVIDER="disabled"

# SMS_API_KEY: API Key / Token from your SMS provider (leave empty in repository)
SMS_API_KEY=""

# SMS_SENDER: Optional sender line number (if required by provider)
SMS_SENDER=""

# SMS_OTP_TEMPLATE: Pattern / Verification template ID or name (e.g. Kavenegar Verify Lookup template or SMS.ir TemplateId)
SMS_OTP_TEMPLATE="beautyhub-otp"

# SMS_API_URL: Optional custom endpoint URL (required only when SMS_PROVIDER="webhook")
SMS_API_URL=""

# ==============================================================================
# ONLINE PAYMENT GATEWAY (Optional - Booking works without prepayment)
# ==============================================================================
# PAYMENT_GATEWAY_PROVIDER: 'disabled' | 'zarinpal'
PAYMENT_GATEWAY_PROVIDER="disabled"

# PAYMENT_MERCHANT_ID: 36-character Merchant ID when PAYMENT_GATEWAY_PROVIDER="zarinpal"
PAYMENT_MERCHANT_ID=""

# ==============================================================================
# ONE-TIME INITIAL PLATFORM_ADMIN BOOTSTRAP
# ==============================================================================
# Used by `npm run db:bootstrap-admin` or `POST /api/v1/admin/bootstrap`.
# Automatically disabled once at least one active PLATFORM_ADMIN exists in PostgreSQL.
INITIAL_ADMIN_PHONE=""
INITIAL_ADMIN_FULL_NAME="مدیر ارشد پلتفرم"
# Generate via: openssl rand -hex 32 (min 32 chars; remove from Liara env after initial bootstrap)
INITIAL_ADMIN_BOOTSTRAP_TOKEN=""

