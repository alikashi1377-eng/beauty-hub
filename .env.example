# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server listening port (defaults to 3000 in development and Liara Node.js platform).
PORT="3000"

# DATA_MODE: Controls backend data mode ('mock' | 'real').
# If omitted, defaults to 'mock' when DATABASE_URL is empty, or 'real' when DATABASE_URL is set.
DATA_MODE="mock"

# DATABASE_URL: Server-side PostgreSQL 17 connection string (e.g., Liara managed PostgreSQL).
# IMPORTANT: Never prefix with VITE_ and never commit real credentials to Git.
DATABASE_URL=""

# DATABASE_SSL: PostgreSQL SSL mode ('disable' | 'no-verify' | 'require').
# For Liara internal network use 'disable'; for Liara external/managed TLS use 'no-verify' or 'require'.
DATABASE_SSL="disable"

